log_format koda_mcp '$time_iso8601 $status $request_method $uri $request_length $body_bytes_sent';

server {
    listen 443 ssl http2;
    server_name koda-mcp.internal.example;

    ssl_certificate /etc/nginx/tls/koda-mcp.internal.example.crt;
    ssl_certificate_key /etc/nginx/tls/koda-mcp.internal.example.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    access_log /var/log/nginx/koda-mcp.access.log koda_mcp;

    location = /mcp {
        client_max_body_size 8m;
        proxy_pass http://127.0.0.1:8766/mcp;
        proxy_http_version 1.1;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_read_timeout 65s;
        proxy_set_header Host $host;
        proxy_set_header Authorization $http_authorization;
    }

    location = /healthz {
        return 404;
    }

    location / {
        return 404;
    }
}
